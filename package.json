{
  "name": "reliable-queue",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/contracts packages/infrastructure packages/api packages/worker packages/dispatcher packages/dashboard packages/loadtest && node scripts/copy-assets.mjs",
    "typecheck": "tsc -b packages/core packages/contracts packages/infrastructure packages/api packages/worker packages/dispatcher packages/dashboard packages/loadtest && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude **/integration.test.ts",
    "test:integration": "cross-env RUN_INTEGRATION_TESTS=1 vitest run packages/infrastructure/src/__tests__/integration.test.ts",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint packages scripts && npm run architecture:check",
    "architecture:check": "node scripts/check-architecture.mjs",
    "migrate": "tsx packages/infrastructure/src/cli.ts migrate",
    "admin": "tsx packages/infrastructure/src/cli.ts",
    "seed": "tsx packages/loadtest/src/seed.ts",
    "loadtest": "tsx packages/loadtest/src/loadtest.ts",
    "dev:api": "npm run dev -w @reliable-queue/api",
    "dev:worker": "npm run dev -w @reliable-queue/worker",
    "dev:dispatcher": "npm run dev -w @reliable-queue/dispatcher",
    "dev:dashboard": "npm run dev -w @reliable-queue/dashboard"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "vitest": "^5.0.4",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "cross-env": "^10.0.0",
    "jsdom": "^26.0.0",
    "@types/jsdom": "^21.1.7",
    "@electric-sql/pglite": "^0.3.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
